# ===== Config por CLIENTE (cambiar en cada deploy) =====
# Base de datos MySQL propia del cliente (NO reutilizar la de otro cliente)
DATABASE_URL="mysql://usuario:password@host:puerto/database?schema=database"
# Dominio publico del frontend del cliente (se usa en links de emails, ej. recupero de password)
FRONTEND_URL="https://frontend-del-cliente.com"

# ===== Entorno =====
# En Railway NO setear PORT: lo inyecta la plataforma
PORT="3000"
NODE_ENV="production"
# Zona horaria para cumpleaños y tareas diarias (default: America/Argentina/Cordoba)
TIMEZONE="America/Argentina/Cordoba"

# ===== Auth =====
JWT_SECRET="cambiar-por-un-valor-seguro"

# ===== Cron =====
# Sólo protege los endpoints HTTP /cron/nightly y /cron/reminders.
# El servicio de cron de Railway corre dist/scripts/dailyCron.js y no lo necesita.
CRON_SECRET="cambiar-por-un-valor-seguro"

# ===== Email (SMTP) =====
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
# El "from" de los mails sale de SMTP_USER
SMTP_USER="usuario@example.com"
SMTP_PASS="app-password"

# ===== Imagenes (Cloudinary) =====
CLOUDINARY_NAME="cloud-name"
CLOUDINARY_API_KEY="api-key"
CLOUDINARY_SECRET_KEY="secret"
